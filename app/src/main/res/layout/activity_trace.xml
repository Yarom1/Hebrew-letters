<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mode_write_bg"
    android:orientation="vertical">

    <include layout="@layout/view_letter_nav" />

    <TextView
        android:id="@+id/letter_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center"
        android:textSize="30sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp">

        <io.github.yarom1.hebrewletters.TraceView
            android:id="@+id/trace"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_card"
            android:elevation="4dp" />

        <TextView
            android:id="@+id/trace_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="14dp"
            android:elevation="5dp"
            android:text="@string/trace_hint"
            android:textColor="@color/ink_soft"
            android:textSize="17sp" />

        <io.github.yarom1.hebrewletters.ConfettiView
            android:id="@+id/confetti"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="10dp" />

        <LinearLayout
            android:id="@+id/success"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_margin="16dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:elevation="12dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="20dp"
            android:paddingEnd="24dp"
            android:paddingBottom="22dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="emoji"
                android:text="⭐⭐⭐"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/success_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/success"
                android:textSize="36sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_again"
                    style="@style/PillButton"
                    android:layout_width="wrap_content"
                    android:layout_weight="0"
                    android:background="@drawable/bg_settings_button"
                    android:minWidth="110dp"
                    android:text="@string/again"
                    android:textColor="@color/ink_dark" />

                <Button
                    android:id="@+id/btn_next_letter"
                    style="@style/PillButton"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="0"
                    android:minWidth="150dp"
                    android:text="@string/to_next_letter"
                    android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="0dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btn_clear"
            style="@style/RoundButton"
            android:contentDescription="@string/clear"
            android:src="@drawable/ic_delete" />

        <!-- Crayon colours; filled in code. The padding leaves room for the enlarged selection. -->
        <LinearLayout
            android:id="@+id/palette"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />
    </LinearLayout>

</LinearLayout>
